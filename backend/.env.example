# Database Configuration (matches docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5433/admin
DB_USERNAME=admin
DB_PASSWORD=admin

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Token Encryption
TOKEN_ENCRYPTOR_PASSWORD=your_local_encrypt_key_change_me
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe

# GitHub OAuth2 App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

